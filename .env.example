# Copy to .env and adjust. Never commit a real .env file.

# Passphrase used by scripts/bootstrap.py to create the demo operator accounts and
# to wrap each node's data-encryption key. Change it for anything beyond a local demo.
RELAYAID_OPERATOR_PASSPHRASE=change-me-demo-passphrase

# Where node databases and keys are created.
RELAYAID_RUNTIME_DIR=runtime-data

# Operator session lifetime in minutes.
RELAYAID_SESSION_MINUTES=60
